---
import BlogPost from '../../layouts/BlogPost.astro';
const base = import.meta.env.BASE_URL;
---

<BlogPost title="Time-Progression Chart" description="Enter your birth details and a target time to generate a full chart of Da Yun, Liu Nian, Liu Yue, Liu Ri, and Liu Shi." lang="en" altLang="中文" altHref="/liupan">
  <p class="lead">Enter your birth date, time, and gender, then pick any target moment to cast the four pillars plus Da Yun, Liu Nian, Liu Yue, Liu Ri, and Liu Shi for that moment.</p>
  <p class="disclaimer">⚠️ For entertainment and cultural curiosity only — not life, financial, or health advice.</p>

  <section class="tool-card">
    <h2>📝 Birth Details & Target Time</h2>
    <div class="tool-form">
      <label class="date-label">Birth date
        <span class="date-selects">
          <select id="lp-year"></select><i>Y</i>
          <select id="lp-month"></select><i>M</i>
          <select id="lp-day"></select><i>D</i>
        </span>
      </label>
      <label class="date-label">Birth time
        <span class="time-selects">
          <select id="lp-hour"></select><i>h</i>
          <select id="lp-min"></select><i>m</i>
        </span>
      </label>
      <label class="date-label">Target date
        <span class="date-selects">
          <select id="tg-year"></select><i>Y</i>
          <select id="tg-month"></select><i>M</i>
          <select id="tg-day"></select><i>D</i>
        </span>
      </label>
      <label class="date-label">Target time
        <span class="time-selects">
          <select id="tg-hour"></select><i>h</i>
          <select id="tg-min"></select><i>m</i>
        </span>
      </label>
      <label>Gender
        <select id="lp-gender">
          <option value="1">Male</option>
          <option value="2">Female</option>
        </select>
      </label>
      <button id="lp-btn" class="tool-btn" type="button">Cast chart</button>
    </div>
  </section>

  <div id="lp-result" hidden>
    <section class="tool-card chart-card">
      <h2>🧭 Chart</h2>
      <div id="lp-summary"></div>
      <div class="table-wrap">
        <table class="lp-table" id="lp-matrix">
          <thead><tr><th></th><th>Year</th><th>Month</th><th>Day</th><th>Hour</th><th>Da Yun</th><th>Liu Nian</th><th>Liu Yue</th><th>Liu Ri</th></tr></thead>
          <tbody>
            <tr><th>Star</th><td id="lp-y-zhu"></td><td id="lp-m-zhu"></td><td id="lp-d-zhu"></td><td id="lp-h-zhu"></td><td id="lp-dy-zhu"></td><td id="lp-ly-zhu"></td><td id="lp-lm-zhu"></td><td id="lp-ld-zhu"></td></tr>
            <tr><th>Stem</th><td id="lp-y-gan"></td><td id="lp-m-gan"></td><td id="lp-d-gan"></td><td id="lp-h-gan"></td><td id="lp-dy-gan"></td><td id="lp-ly-gan"></td><td id="lp-lm-gan"></td><td id="lp-ld-gan"></td></tr>
            <tr><th>Branch</th><td id="lp-y-zhi"></td><td id="lp-m-zhi"></td><td id="lp-d-zhi"></td><td id="lp-h-zhi"></td><td id="lp-dy-zhi"></td><td id="lp-ly-zhi"></td><td id="lp-lm-zhi"></td><td id="lp-ld-zhi"></td></tr>
            <tr><th>Hidden</th><td id="lp-y-cang"></td><td id="lp-m-cang"></td><td id="lp-d-cang"></td><td id="lp-h-cang"></td><td id="lp-dy-cang"></td><td id="lp-ly-cang"></td><td id="lp-lm-cang"></td><td id="lp-ld-cang"></td></tr>
            <tr><th>Stage</th><td id="lp-y-dishi"></td><td id="lp-m-dishi"></td><td id="lp-d-dishi"></td><td id="lp-h-dishi"></td><td id="lp-dy-dishi"></td><td id="lp-ly-dishi"></td><td id="lp-lm-dishi"></td><td id="lp-ld-dishi"></td></tr>
            <tr><th>Seat</th><td id="lp-y-zizuo"></td><td id="lp-m-zizuo"></td><td id="lp-d-zizuo"></td><td id="lp-h-zizuo"></td><td id="lp-dy-zizuo"></td><td id="lp-ly-zizuo"></td><td id="lp-lm-zizuo"></td><td id="lp-ld-zizuo"></td></tr>
            <tr><th>Shen Sha</th><td id="lp-y-shensha" class="shensha"></td><td id="lp-m-shensha" class="shensha"></td><td id="lp-d-shensha" class="shensha"></td><td id="lp-h-shensha" class="shensha"></td><td id="lp-dy-shensha" class="shensha"></td><td id="lp-ly-shensha" class="shensha"></td><td id="lp-lm-shensha" class="shensha"></td><td id="lp-ld-shensha" class="shensha"></td></tr>
            <tr><th>Na Yin</th><td id="lp-y-nayin" class="nayin"></td><td id="lp-m-nayin" class="nayin"></td><td id="lp-d-nayin" class="nayin"></td><td id="lp-h-nayin" class="nayin"></td><td id="lp-dy-nayin" class="nayin"></td><td id="lp-ly-nayin" class="nayin"></td><td id="lp-lm-nayin" class="nayin"></td><td id="lp-ld-nayin" class="nayin"></td></tr>
            <tr><th>Tai Yuan</th><td colspan="8" id="lp-taiyuan" class="sanyuan"></td></tr>
            <tr><th>Ming Gong</th><td colspan="8" id="lp-minggong" class="sanyuan"></td></tr>
            <tr><th>Shen Gong</th><td colspan="8" id="lp-shengong" class="sanyuan"></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="tool-card interp-card">
      <h2>📖 Chart Interpretation</h2>
      <div id="lp-interp"></div>
    </section>

    <section class="tool-card">
      <h2>🌊 Da Yun (Great Luck)</h2>
      <div class="table-wrap"><table class="lp-table" id="lp-dayun"></table></div>
    </section>

    <section class="tool-card">
      <h2>📅 Liu Nian (Year)</h2>
      <div class="table-wrap"><table class="lp-table" id="lp-liunian"></table></div>
    </section>

    <section class="tool-card">
      <h2>🌙 Liu Yue (Month)</h2>
      <div class="table-wrap"><table class="lp-table" id="lp-liuyue"></table></div>
    </section>

    <section class="tool-card">
      <h2>☀️ Liu Ri (Day)</h2>
      <div class="table-wrap"><table class="lp-table" id="lp-liuri"></table></div>
    </section>

    <section class="tool-card">
      <h2>⏰ Liu Shi (Hour)</h2>
      <div class="table-wrap"><table class="lp-table" id="lp-liushi"></table></div>
    </section>

    <section class="tool-card">
      <h2>🔁 Stem-Branch Interactions</h2>
      <div id="lp-relations"></div>
    </section>
  </div>

  <p style="margin-top: 24px;"><a href={`${base}en/tools`}>← Back to toolkit</a></p>

  <style>
    .lead { color: var(--muted); font-size: 16px; }
    .disclaimer { background: var(--code-bg); border: 1px dashed var(--border); border-radius: 8px; padding: 10px 14px; font-size: 13px; color: var(--muted); }
    .tool-card { border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; margin: 20px 0; background: var(--bg); }
    .tool-card h2 { margin-top: 0; border-left: 4px solid var(--accent); padding-left: 10px; }
    .chart-card { padding: 0; overflow: hidden; }
    .chart-card h2 { margin: 18px 20px 0; }
    .chart-card #lp-summary { margin: 8px 20px 12px; }
    .tool-form { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; margin-top: 10px; }
    .tool-form label { font-size: 14px; color: var(--fg); display: flex; flex-direction: column; gap: 4px; }
    .tool-form input, .tool-form select { padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--fg); font-size: 14px; }
    .date-label { font-size: 14px; color: var(--fg); display: flex; flex-direction: column; gap: 4px; }
    .date-selects, .time-selects { display: inline-flex; align-items: center; gap: 5px; flex-wrap: wrap; }
    .date-selects select, .time-selects select { padding: 8px 6px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--fg); font-size: 14px; }
    .date-selects i, .time-selects i { font-style: normal; color: var(--muted); font-size: 14px; }
    .tool-btn { padding: 9px 18px; border: 1px solid var(--accent); background: var(--accent); color: #fff; border-radius: 8px; cursor: pointer; font-size: 14px; transition: transform .15s, opacity .15s; text-decoration: none; display: inline-block; }
    .tool-btn:hover { transform: translateY(-1px); opacity: .92; }
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .lp-table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 640px; }
    .lp-table th, .lp-table td { border: 1px solid var(--border); padding: 8px 5px; text-align: center; }
    .lp-table thead th { background: var(--code-bg); color: var(--muted); font-size: 13px; }
    .lp-table tbody th { background: var(--code-bg); color: var(--muted); font-size: 13px; }
    .lp-table td { color: var(--fg); }
    .gz { font-size: 18px; font-weight: 700; color: var(--accent); }
    .cang { font-size: 12px; color: var(--muted); }
    .zhu { font-size: 13px; font-weight: 600; }
    .dishi { font-size: 12px; color: var(--muted); }
    .shensha { font-size: 11px; color: var(--muted); line-height: 1.4; max-width: 90px; }
    .nayin { font-size: 11px; color: var(--muted); line-height: 1.3; }
    .sanyuan { text-align: left; font-size: 13px; color: var(--fg); padding-left: 14px; }
    .sanyuan .gz { font-size: 16px; margin: 0 6px; }
    .current { background: rgba(124,92,255,0.10); }
    .relation-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 8px 0; font-size: 14px; }
    .relation-pill { border: 1px solid var(--border); border-radius: 999px; padding: 4px 10px; background: var(--code-bg); }

    .interp-card .interp-grid { display: flex; flex-wrap: wrap; gap: 10px; margin: 6px 0 16px; }
    .interp-chip { border: 1px solid var(--border); border-radius: 10px; padding: 8px 12px; background: var(--code-bg); min-width: 110px; }
    .interp-chip .k { font-size: 12px; color: var(--muted); }
    .interp-chip .v { font-size: 15px; font-weight: 600; color: var(--accent); margin-top: 2px; }
    .interp-sec { margin: 14px 0; }
    .interp-sec h4 { margin: 0 0 6px; font-size: 14px; color: var(--fg); border-left: 3px solid var(--accent); padding-left: 8px; }
    .interp-sec p { margin: 0; font-size: 14px; line-height: 1.8; color: var(--fg); }
    .interp-foot { font-size: 12px; color: var(--muted); margin-top: 14px; }
  </style>

  <script is:inline src={`${base}lunar.js`}></script>
  <script is:inline src={`${base}paywall.js`}></script>
  <script is:inline>
    const ZHI_CANG = {
      '子': '癸', '丑': '己癸辛', '寅': '甲丙戊', '卯': '乙', '辰': '戊乙癸', '巳': '丙戊庚',
      '午': '丁己', '未': '己丁乙', '申': '庚壬戊', '酉': '辛', '戌': '戊辛丁', '亥': '壬甲'
    };
    const ZHI_TIME = ['子','丑','寅','卯','辰','巳','午','未','申','酉','戌','亥'];
    const TIME_LABEL = ['23-01','01-03','03-05','05-07','07-09','09-11','11-13','13-15','15-17','17-19','19-21','21-23'];

    const GAN_WUXING = {甲:'木',乙:'木',丙:'火',丁:'火',戊:'土',己:'土',庚:'金',辛:'金',壬:'水',癸:'水'};
    const GAN_YINYANG = {甲:'阳',乙:'阴',丙:'阳',丁:'阴',戊:'阳',己:'阴',庚:'阳',辛:'阴',壬:'阳',癸:'阴'};
    const WUXING_SHENG = {木:'火',火:'土',土:'金',金:'水',水:'木'};
    const WUXING_KE = {木:'土',土:'水',水:'火',火:'金',金:'木'};

    const CHANGSHENG = {
      甲: ['亥','子','丑','寅','卯','辰','巳','午','未','申','酉','戌'],
      丙: ['寅','卯','辰','巳','午','未','申','酉','戌','亥','子','丑'],
      戊: ['寅','卯','辰','巳','午','未','申','酉','戌','亥','子','丑'],
      庚: ['巳','午','未','申','酉','戌','亥','子','丑','寅','卯','辰'],
      壬: ['申','酉','戌','亥','子','丑','寅','卯','辰','巳','午','未'],
      乙: ['午','巳','辰','卯','寅','丑','子','亥','戌','酉','申','未'],
      丁: ['酉','申','未','午','巳','辰','卯','寅','丑','子','亥','戌'],
      己: ['酉','申','未','午','巳','辰','卯','寅','丑','子','亥','戌'],
      辛: ['子','亥','戌','酉','申','未','午','巳','辰','卯','寅','丑'],
      癸: ['卯','寅','丑','子','亥','戌','酉','申','未','午','巳','辰']
    };
    const CHANGSHENG_NAMES = ['长生','沐浴','冠带','临官','帝旺','衰','病','死','墓','绝','胎','养'];

    function splitGZ(gz) { return gz ? { gan: gz[0], zhi: gz[1], cang: ZHI_CANG[gz[1]] || '' } : { gan: '-', zhi: '-', cang: '-' }; }
    function formatDate(d) { return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }

    function shiShen(dayGan, targetGan) {
      if (dayGan === targetGan) return 'Day Master';
      const dw = GAN_WUXING[dayGan], tw = GAN_WUXING[targetGan];
      const dy = GAN_YINYANG[dayGan], ty = GAN_YINYANG[targetGan];
      const same = dy === ty;
      if (dw === tw) return same ? '比肩' : '劫财';
      if (WUXING_SHENG[dw] === tw) return same ? '食神' : '伤官';
      if (WUXING_KE[dw] === tw) return same ? '偏财' : '正财';
      if (WUXING_SHENG[tw] === dw) return same ? '偏印' : '正印';
      if (WUXING_KE[tw] === dw) return same ? '七杀' : '正官';
      return '';
    }
    function diShi(gan, zhi) {
      const idx = CHANGSHENG[gan].indexOf(zhi);
      return idx >= 0 ? CHANGSHENG_NAMES[idx] : '-';
    }
    function shenSha(gan, zhi, dayGan, dayZhi, xunKong) {
      const list = [];
      const tianyi = {甲:['丑','未'],戊:['丑','未'],庚:['丑','未'],乙:['子','申'],己:['子','申'],丙:['亥','酉'],丁:['亥','酉'],壬:['卯','巳'],癸:['卯','巳'],辛:['寅','午']};
      const wenchang = {甲:'巳',乙:'午',丙:'申',戊:'申',丁:'酉',己:'酉',庚:'亥',辛:'子',壬:'寅',癸:'卯'};
      const yangren = {甲:'卯',乙:'寅',丙:'午',戊:'午',丁:'巳',己:'巳',庚:'酉',辛:'申',壬:'子',癸:'亥'};
      const yima = {申:'寅',子:'寅',辰:'寅',寅:'申',午:'申',戌:'申',巳:'亥',酉:'亥',丑:'亥',亥:'巳',卯:'巳',未:'巳'};
      const taohua = {申:'酉',子:'酉',辰:'酉',寅:'卯',午:'卯',戌:'卯',巳:'午',酉:'午',丑:'午',亥:'子',卯:'子',未:'子'};
      const huagai = {申:'辰',子:'辰',辰:'辰',寅:'戌',午:'戌',戌:'戌',巳:'丑',酉:'丑',丑:'丑',亥:'未',卯:'未',未:'未'};
      if (tianyi[dayGan]?.includes(zhi)) list.push('天乙');
      if (wenchang[dayGan] === zhi) list.push('文昌');
      if (yangren[dayGan] === zhi) list.push('羊刃');
      if (yima[dayZhi] === zhi) list.push('驿马');
      if (taohua[dayZhi] === zhi) list.push('桃花');
      if (huagai[dayZhi] === zhi) list.push('华盖');
      if (xunKong && xunKong.includes(zhi)) list.push('空亡');
      return list;
    }

    const NAYIN = {
      '甲子':'海中金','乙丑':'海中金','丙寅':'炉中火','丁卯':'炉中火','戊辰':'大林木','己巳':'大林木',
      '庚午':'路旁土','辛未':'路旁土','壬申':'剑锋金','癸酉':'剑锋金','甲戌':'山头火','乙亥':'山头火',
      '丙子':'涧下水','丁丑':'涧下水','戊寅':'城头土','己卯':'城头土','庚辰':'白蜡金','辛巳':'白蜡金',
      '壬午':'杨柳木','癸未':'杨柳木','甲申':'泉中水','乙酉':'泉中水','丙戌':'屋上土','丁亥':'屋上土',
      '戊子':'霹雳火','己丑':'霹雳火','庚寅':'松柏木','辛卯':'松柏木','壬辰':'长流水','癸巳':'长流水',
      '甲午':'沙中金','乙未':'沙中金','丙申':'山下火','丁酉':'山下火','戊戌':'平地木','己亥':'平地木',
      '庚子':'壁上土','辛丑':'壁上土','壬寅':'金箔金','癸卯':'金箔金','甲辰':'覆灯火','乙巳':'覆灯火',
      '丙午':'天河水','丁未':'天河水','戊申':'大驿土','己酉':'大驿土','庚戌':'钗钏金','辛亥':'钗钏金',
      '壬子':'桑柘木','癸丑':'桑柘木','甲寅':'大溪水','乙卯':'大溪水','丙辰':'沙中土','丁巳':'沙中土',
      '戊午':'天上火','己未':'天上火','庚申':'石榴木','辛酉':'石榴木','壬戌':'大海水','癸亥':'大海水'
    };
    function nayinOf(gz) { return NAYIN[gz] || ''; }

    function sortPair(a, b) { return a < b ? a + b : b + a; }
    function pairMap(pairs) { const m = {}; pairs.forEach(([a, b, v]) => { m[sortPair(a, b)] = v; }); return m; }
    function trioMap(trios) { const m = {}; trios.forEach(([a, b, c, v]) => { m[[a, b, c].sort().join('')] = v; }); return m; }
    const LIU_HE = pairMap([['子','丑','土'],['寅','亥','木'],['卯','戌','火'],['辰','酉','金'],['巳','申','水'],['午','未','火']]);
    const LIU_CHONG = pairMap([['子','午',''],['丑','未',''],['寅','申',''],['卯','酉',''],['辰','戌',''],['巳','亥','']]);
    const LIU_HAI = pairMap([['子','未',''],['丑','午',''],['寅','巳',''],['卯','辰',''],['申','亥',''],['酉','戌','']]);
    const LIU_PO = pairMap([['子','酉',''],['丑','辰',''],['寅','亥',''],['卯','午',''],['巳','申',''],['未','戌','']]);
    const LIU_XING = pairMap([['子','卯','无礼之刑']]);
    const SAN_HE = trioMap([['申','子','辰','水'],['亥','卯','未','木'],['寅','午','戌','火'],['巳','酉','丑','金']]);
    const SAN_XING = trioMap([['寅','巳','申','无恩之刑'],['丑','戌','未','恃势之刑']]);

    function computeRelationsEN(list) {
      const pills = [];
      for (let i = 0; i < list.length; i++) {
        for (let j = i + 1; j < list.length; j++) {
          const a = list[i], b = list[j];
          const key = sortPair(a.z, b.z);
          if (LIU_HE[key] !== undefined) pills.push(`${a.l}·${b.l} ${a.z}${b.z} combine(${LIU_HE[key]})`);
          if (LIU_CHONG[key] !== undefined) pills.push(`${a.l}·${b.l} ${a.z}${b.z} clash`);
          if (LIU_HAI[key] !== undefined) pills.push(`${a.l}·${b.l} ${a.z}${b.z} harm`);
          if (LIU_PO[key] !== undefined) pills.push(`${a.l}·${b.l} ${a.z}${b.z} break`);
          if (LIU_XING[key] !== undefined) pills.push(`${a.l}·${b.l} ${a.z}${b.z} ${LIU_XING[key]}`);
        }
      }
      for (let i = 0; i < list.length; i++) {
        for (let j = i + 1; j < list.length; j++) {
          for (let k = j + 1; k < list.length; k++) {
            const arr = [list[i].z, list[j].z, list[k].z].sort().join('');
            if (SAN_HE[arr] !== undefined) pills.push(`${list[i].l}${list[j].l}${list[k].l} ${arr} 3-combo(${SAN_HE[arr]})`);
            if (SAN_XING[arr] !== undefined) pills.push(`${list[i].l}${list[j].l}${list[k].l} ${arr} ${SAN_XING[arr]}`);
          }
        }
      }
      if (!pills.length) return '<p style="font-size:13px;color:var(--muted)">No obvious 6-combine / 6-clash / 6-harm / 3-combo / 3-punish interactions among the four pillars and the current Da Yun / Liu Nian branches.</p>';
      return '<div class="relation-row">' + pills.map(p => `<span class="relation-pill">${p}</span>`).join('') + '</div>' +
        '<p style="font-size:13px;color:var(--muted)">Note: 6-combine / 3-combo are "harmonizing"; 6-clash / 6-harm / 6-break / 3-punish are "conflicting". Listed for the four natal pillars vs the current Da Yun and Liu Nian branches, for entertainment only.</p>';
    }

    function fillDayOptions(ySel, mSel, dSel, defD) {
      const y = +ySel.value, m = +mSel.value;
      const max = new Date(y, m, 0).getDate();
      dSel.innerHTML = '';
      for (let d = 1; d <= max; d++) {
        const o = document.createElement('option');
        o.value = d; o.textContent = d;
        if (d === defD) o.selected = true;
        dSel.appendChild(o);
      }
    }
    function setupDate(prefix, defY, defM, defD) {
      const ySel = document.getElementById(prefix + '-year');
      const mSel = document.getElementById(prefix + '-month');
      const dSel = document.getElementById(prefix + '-day');
      const START = 1920, END = 2035;
      if (!ySel || !mSel || !dSel) return;
      for (let y = END; y >= START; y--) { const o = document.createElement('option'); o.value = y; o.textContent = y; if (y === defY) o.selected = true; ySel.appendChild(o); }
      for (let m = 1; m <= 12; m++) { const o = document.createElement('option'); o.value = m; o.textContent = m; if (m === defM) o.selected = true; mSel.appendChild(o); }
      fillDayOptions(ySel, mSel, dSel, defD);
      ySel.addEventListener('change', () => fillDayOptions(ySel, mSel, dSel, +dSel.value || 1));
      mSel.addEventListener('change', () => fillDayOptions(ySel, mSel, dSel, +dSel.value || 1));
    }
    function readDate(prefix) {
      const y = +document.getElementById(prefix + '-year').value;
      const m = +document.getElementById(prefix + '-month').value;
      const d = +document.getElementById(prefix + '-day').value;
      if (!y || !m || !d) return null;
      return { y, m, d };
    }
    function setupTime(prefix, defH, defM) {
      const hSel = document.getElementById(prefix + '-hour');
      const mSel = document.getElementById(prefix + '-min');
      if (!hSel || !mSel) return;
      for (let h = 0; h < 24; h++) { const o = document.createElement('option'); o.value = h; o.textContent = h; if (h === defH) o.selected = true; hSel.appendChild(o); }
      for (let m = 0; m < 60; m++) { const o = document.createElement('option'); o.value = String(m).padStart(2,'0'); o.textContent = String(m).padStart(2,'0'); if (m === defM) o.selected = true; mSel.appendChild(o); }
    }
    function readTime(prefix) {
      const h = +document.getElementById(prefix + '-hour').value;
      const m = +document.getElementById(prefix + '-min').value;
      return { h, m };
    }

    function compute(birthSolar, gender, targetSolar) {
      const birthLunar = Lunar.fromSolar(birthSolar);
      const ec = birthLunar.getEightChar();
      const yun = ec.getYun(gender);
      const dayun = yun.getDaYun();
      const targetYear = targetSolar.getYear();
      const targetMonth = targetSolar.getMonth();

      let currentDaYun = dayun.slice(1).find(d => {
        const start = d.getStartYear();
        const idx = dayun.indexOf(d);
        const end = idx < dayun.length - 1 ? dayun[idx + 1].getStartYear() : start + 10;
        return targetYear >= start && targetYear < end;
      }) || dayun[dayun.length - 1];

      const liunianList = currentDaYun.getLiuNian();
      const currentLiuNian = liunianList.find(l => l.getYear() === targetYear) || liunianList[0];
      const liuyueList = currentLiuNian.getLiuYue();
      const currentLiuYue = liuyueList.find(l => {
        const m = l.getMonthInChinese();
        const map = {'正':1,'二':2,'三':3,'四':4,'五':5,'六':6,'七':7,'八':8,'九':9,'十':10,'冬':11,'腊':12};
        return map[m] === targetMonth;
      }) || liuyueList[0];

      const targetLunar = Lunar.fromSolar(targetSolar);
      const targetDayGZ = targetLunar.getEightChar().getDay();
      const targetHourGZ = targetLunar.getEightChar().getTime();

      return {
        year: ec.getYear(), month: ec.getMonth(), day: ec.getDay(), time: ec.getTime(),
        currentDaYun: currentDaYun.getGanZhi(),
        currentLiuNian: currentLiuNian.getGanZhi(),
        currentLiuYue: currentLiuYue.getGanZhi(),
        currentLiuRi: targetDayGZ,
        currentLiuShi: targetHourGZ,
        dayun: dayun,
        liunian: liunianList,
        liuyue: liuyueList,
        xunkong: {
          year: ec.getYearXunKong(), month: ec.getMonthXunKong(),
          day: ec.getDayXunKong(), time: ec.getTimeXunKong()
        }
      };
    }

    function liuComment(gan, dayGan) {
      const ss = shiShen(dayGan, gan);
      const map = {
        '正官': 'new structure or constraints at work — favor steadiness over bold moves.',
        '七杀': 'pressure and challenges coexist — good for breakthroughs, but guard against conflict and burnout.',
        '正财': 'steady income is in focus — solid, reliable earnings.',
        '偏财': 'side income appears — windfalls or investment openings; take profit when you have it.',
        '正印': 'strong benefactor and study luck — good for exams, learning, and elder support.',
        '偏印': 'unconventional talent and inspiration surface, but watch overthinking — stay focused on one thing.',
        '食神': 'talent turns outward and mood lifts — good for expression, creativity, and rapport.',
        '伤官': 'sharp wit but a pointed tongue — avoid disputes; keep it measured.',
        '比肩': 'peer support is strong — good for cooperation, though watch shared costs.',
        '劫财': 'competition rises and money scatters easily — settle accounts clearly when partnering.'
      };
      return (ss && map[ss]) ? (' (' + ss + ') ' + map[ss]) : '';
    }
    function interpret(data, dayGan, dayZhi) {
      const dw = GAN_WUXING[dayGan];
      const pillars = [data.year, data.month, data.day, data.time, data.currentDaYun, data.currentLiuNian, data.currentLiuYue, data.currentLiuRi, data.currentLiuShi].filter(Boolean);
      const wuCount = { '木': 0, '火': 0, '土': 0, '金': 0, '水': 0 };
      let score = 0;
      pillars.forEach(function (gz) {
        const sp = splitGZ(gz);
        const gw = GAN_WUXING[sp.gan];
        const zb = ZHI_CANG[sp.zhi] ? ZHI_CANG[sp.zhi][0] : sp.gan;
        const zw = GAN_WUXING[zb];
        [[gw, 1], [zw, 0.5]].forEach(function (pair) {
          const w = pair[0]; const wt = pair[1];
          wuCount[w] += wt;
          if (w === dw) score += wt;
          else if (WUXING_SHENG[w] === dw) score += wt;
          else if (WUXING_SHENG[dw] === w) score -= wt;
          else if (WUXING_KE[dw] === w) score -= wt;
          else if (WUXING_KE[w] === dw) score -= wt;
        });
      });
      const monthZhi = data.month[1];
      const stage = diShi(dayGan, monthZhi);
      const strongStage = ['长生', '冠带', '临官', '帝旺'];
      if (strongStage.indexOf(stage) >= 0) score += 1.5;
      else if (['墓', '养'].indexOf(stage) >= 0) score += 0.3;
      else score -= 1.0;
      let label, advice;
      if (score >= 2) { label = 'Strong'; advice = 'balance it with controlling, draining, or consuming elements'; }
      else if (score <= -2) { label = 'Weak'; advice = 'support the day master with generating and helping elements'; }
      else { label = 'Balanced'; advice = 'adjust for climate (warm/cool, damp/dry); overall fairly even'; }
      const yin = []; for (const k in WUXING_SHENG) if (WUXING_SHENG[k] === dw) yin.push(k);
      const keWo = []; for (const k in WUXING_KE) if (WUXING_KE[k] === dw) keWo.push(k);
      let xi;
      if (label.indexOf('Weak') >= 0) xi = [dw].concat(yin);
      else if (label.indexOf('Strong') >= 0) xi = keWo.concat([WUXING_SHENG[dw], WUXING_KE[dw]]);
      else xi = [dw].concat(yin, [WUXING_SHENG[dw]]);
      const seen = {}; xi = xi.filter(function (v) { if (seen[v]) return false; seen[v] = 1; return true; });
      const missing = []; for (const k in wuCount) if (wuCount[k] === 0) missing.push(k);
      const weakEls = Object.keys(wuCount).sort(function (a, b) { return wuCount[a] - wuCount[b]; }).slice(0, 2);
      const wuLabel = { '木': 'Wood', '火': 'Fire', '土': 'Earth', '金': 'Metal', '水': 'Water' };
      const wuStr = ['木', '火', '土', '金', '水'].map(function (k) { return wuLabel[k] + ' ' + (Math.round(wuCount[k] * 10) / 10); }).join(' · ');
      const catCount = { '官杀': 0, '财': 0, '印': 0, '食伤': 0, '比劫': 0 };
      const catMap = { '正官': '官杀', '七杀': '官杀', '正财': '财', '偏财': '财', '正印': '印', '偏印': '印', '食神': '食伤', '伤官': '食伤', '比肩': '比劫', '劫财': '比劫' };
      pillars.forEach(function (gz) { const ss = shiShen(dayGan, gz[0]); if (catMap[ss]) catCount[catMap[ss]]++; });
      const catDesc = [];
      if (catCount['财']) catDesc.push('wealth stars stand out — practical and gain-oriented');
      if (catCount['官杀']) catDesc.push('career/authority stars are strong — driven, with self-imposed pressure');
      if (catCount['印']) catDesc.push('resource stars assist — fond of learning, easy to get help');
      if (catCount['食伤']) catDesc.push('expression stars show — talented and expressive');
      if (catCount['比劫']) catDesc.push('peer stars abound — loyal, with many friends');
      const catText = catDesc.length ? (catDesc.join('; ') + '.') : 'The ten gods are fairly evenly distributed.';
      const lyC = liuComment(data.currentLiuNian ? data.currentLiuNian[0] : '', dayGan);
      const lmC = liuComment(data.currentLiuYue ? data.currentLiuYue[0] : '', dayGan);
      const ldC = liuComment(data.currentLiuRi ? data.currentLiuRi[0] : '', dayGan);
      const lsC = liuComment(data.currentLiuShi ? data.currentLiuShi[0] : '', dayGan);
      const ms = shiShen(dayGan, data.month[0]);
      const missXi = missing.filter(function (m) { return xi.indexOf(m) >= 0; });
      return ''
        + '<div class="interp-grid">'
        + '<div class="interp-chip"><div class="k">Day Master</div><div class="v">' + dayGan + dayZhi + ' (' + wuLabel[dw] + ')</div></div>'
        + '<div class="interp-chip"><div class="k">Strength</div><div class="v">' + label + '</div></div>'
        + '<div class="interp-chip"><div class="k">Month Lord</div><div class="v">' + monthZhi + ' · ' + stage + '</div></div>'
        + '<div class="interp-chip"><div class="k">Favorable</div><div class="v">' + xi.map(e => wuLabel[e]).join(', ') + '</div></div>'
        + '</div>'
        + '<div class="interp-sec"><h4>Pattern & Strength</h4><p>The day master is <b>' + wuLabel[dw] + '</b> (' + dayGan + dayZhi + '), and the chart reads as <b>' + label + '</b>. The month branch ' + monthZhi + ' sits at "' + stage + '" ' + (strongStage.indexOf(stage) >= 0 ? '(in season)' : '(out of season)') + '; ' + advice + '. The month stem is ' + data.month[0] + ' (' + ms + '), and the day master seats on ' + dayZhi + '.</p></div>'
        + '<div class="interp-sec"><h4>Five-Element Spread</h4><p>Wood·Fire·Earth·Metal·Water counts: ' + wuStr + '. ' + (missing.length ? 'The chart <b>lacks ' + missing.map(e => wuLabel[e]).join(', ') + '</b>; ' : 'No obvious element is missing; ') + 'the relatively weakest are ' + weakEls.map(e => wuLabel[e]).join(', ') + '. ' + (missXi.length ? 'What is missing happens to be favorable — replenish ' + missXi.map(e => wuLabel[e]).join(', ') + ' via dress, direction, or industry.' : '') + '</p></div>'
        + '<div class="interp-sec"><h4>Ten-God Pattern</h4><p>' + catText + '</p></div>'
        + '<div class="interp-sec"><h4>Favorable Elements</h4><p>Favorable elements are <b>' + xi.map(e => wuLabel[e]).join(', ') + '</b>. ' + (label.indexOf('Weak') >= 0 ? 'The chart leans weak — lean toward the favorable elements to support the day master.' : label.indexOf('Strong') >= 0 ? 'The chart leans strong — use the favorable elements to drain and harmonize.' : 'Overall balanced — treat the favorable elements as a climate-adjustment reference.') + '</p></div>'
        + '<div class="interp-sec"><h4>Da Yun · Liu Nian · Liu Yue · Liu Ri · Liu Shi Notes</h4><p>'
        + 'Current Da Yun <b>' + (data.currentDaYun || '—') + '</b>; '
        + 'Liu Nian <b>' + (data.currentLiuNian || '—') + '</b>' + lyC + ' '
        + 'Liu Yue <b>' + (data.currentLiuYue || '—') + '</b>' + lmC + ' '
        + 'Liu Ri <b>' + (data.currentLiuRi || '—') + '</b>' + ldC + ' '
        + 'Liu Shi <b>' + (data.currentLiuShi || '—') + '</b>' + lsC
        + '</p></div>'
        + '<p class="interp-foot">※ This is a rule-based auto-interpretation for entertainment and cultural curiosity only — not life, financial, or health advice.</p>';
    }

    function render() {
      const p = readDate('lp');
      if (!p) { alert('Please pick a birth date'); return; }
      const { h: hh, m: mm } = readTime('lp');
      const gender = +document.getElementById('lp-gender').value;
      const { y, m, d } = p;
      const birthSolar = Solar.fromYmdHms(y, m, d, hh, mm, 0);

      const tp = readDate('tg');
      const { h: th, m: tmin } = readTime('tg');
      let targetSolar;
      if (tp) {
        targetSolar = Solar.fromYmdHms(tp.y, tp.m, tp.d, th, tmin, 0);
      } else {
        targetSolar = Solar.fromDate(new Date());
      }

      const data = compute(birthSolar, gender, targetSolar);
      document.getElementById('lp-result').hidden = false;

      const birthLunar = Lunar.fromSolar(birthSolar);
      const prevTerm = birthLunar.getPrevJieQi();
      const nextTerm = birthLunar.getNextJieQi();
      const termToday = birthLunar.getJieQi();
      const termText = termToday
        ? `Birth solar term: ${termToday}`
        : `Birth solar term: ${birthSolar.subtract(prevTerm.getSolar())} days after ${prevTerm.getName()}, ${nextTerm.getSolar().subtract(birthSolar)} days before ${nextTerm.getName()}`;
      const tg = readDate('tg');
      const targetText = tg
        ? `Target: ${tg.y}-${String(tg.m).padStart(2,'0')}-${String(tg.d).padStart(2,'0')} ${String(th).padStart(2,'0')}:${String(tmin).padStart(2,'0')}`
        : `Target: ${formatDate(new Date())} (now)`;
      document.getElementById('lp-summary').innerHTML =
        `<p><b>${y}-${String(m).padStart(2,'0')}-${String(d).padStart(2,'0')} ${String(hh).padStart(2,'0')}:${String(mm).padStart(2,'0')}</b> · ${termText}</p>` +
        `<p style="font-size:13px;color:var(--muted)">${targetText}</p>`;

      const dayGan = data.day[0];
      const dayZhi = data.day[1];
      const cols = [
        ['lp-y', data.year, data.xunkong.year], ['lp-m', data.month, data.xunkong.month],
        ['lp-d', data.day, data.xunkong.day], ['lp-h', data.time, data.xunkong.time],
        ['lp-dy', data.currentDaYun, ''], ['lp-ly', data.currentLiuNian, ''],
        ['lp-lm', data.currentLiuYue, ''], ['lp-ld', data.currentLiuRi, '']
      ];
      cols.forEach(([prefix, gz, xk]) => {
        const { gan, zhi, cang } = splitGZ(gz);
        const isDay = prefix === 'lp-d';
        document.getElementById(prefix + '-zhu').innerHTML = `<span class="zhu">${isDay ? 'Day Master' : shiShen(dayGan, gan)}</span>`;
        document.getElementById(prefix + '-gan').innerHTML = `<span class="gz">${gan}</span>`;
        document.getElementById(prefix + '-zhi').innerHTML = `<span class="gz">${zhi}</span>`;
        document.getElementById(prefix + '-cang').innerHTML = `<span class="cang">${cang}</span>`;
        document.getElementById(prefix + '-dishi').innerHTML = `<span class="dishi">${diShi(dayGan, zhi)}</span>`;
        document.getElementById(prefix + '-zizuo').innerHTML = `<span class="dishi">${diShi(gan, zhi)}</span>`;
        const ss = shenSha(gan, zhi, dayGan, dayZhi, xk);
        document.getElementById(prefix + '-shensha').innerHTML = ss.length ? `<span class="cang">${ss.join(' ')}</span>` : '<span class="cang">-</span>';
        document.getElementById(prefix + '-nayin').innerHTML = `<span class="nayin">${nayinOf(gz)}</span>`;
      });

      const dyRows = data.dayun.slice(1).map(d => {
        const gz = d.getGanZhi();
        const start = d.getStartYear();
        const age = d.getStartAge();
        const end = start + 9;
        const isCur = gz === data.currentDaYun;
        return `<tr class="${isCur ? 'current' : ''}"><td>${start}–${end}</td><td>${age}–${age+9}</td><td><span class="gz">${gz}</span></td></tr>`;
      }).join('');
      document.getElementById('lp-dayun').innerHTML =
        `<thead><tr><th>Years</th><th>Ages</th><th>Pillar</th></tr></thead><tbody>${dyRows}</tbody>`;

      const lnRows = data.liunian.map(l => {
        const gz = l.getGanZhi();
        const isCur = gz === data.currentLiuNian;
        return `<tr class="${isCur ? 'current' : ''}"><td>${l.getYear()}</td><td>${l.getAge()}</td><td><span class="gz">${gz}</span></td></tr>`;
      }).join('');
      document.getElementById('lp-liunian').innerHTML =
        `<thead><tr><th>Year</th><th>Age</th><th>Pillar</th></tr></thead><tbody>${lnRows}</tbody>`;

      const lmRows = data.liuyue.map(l => {
        const gz = l.getGanZhi();
        const isCur = gz === data.currentLiuYue;
        return `<tr class="${isCur ? 'current' : ''}"><td>${l.getMonthInChinese()}</td><td><span class="gz">${gz}</span></td></tr>`;
      }).join('');
      document.getElementById('lp-liuyue').innerHTML =
        `<thead><tr><th>Month</th><th>Pillar</th></tr></thead><tbody>${lmRows}</tbody>`;

      const tDate = new Date(targetSolar.getYear(), targetSolar.getMonth() - 1, targetSolar.getDay());
      let ldRows = '';
      for (let i = -15; i <= 15; i++) {
        const dt = new Date(tDate); dt.setDate(tDate.getDate() + i);
        const s = Solar.fromYmd(dt.getFullYear(), dt.getMonth() + 1, dt.getDate());
        const l = Lunar.fromSolar(s);
        const gz = l.getEightChar().getDay();
        const isCur = i === 0;
        ldRows += `<tr class="${isCur ? 'current' : ''}"><td>${formatDate(dt)}</td><td><span class="gz">${gz}</span></td></tr>`;
      }
      document.getElementById('lp-liuri').innerHTML =
        `<thead><tr><th>Date</th><th>Pillar</th></tr></thead><tbody>${ldRows}</tbody>`;

      let lsRows = '';
      for (let i = 0; i < 12; i++) {
        const s = Solar.fromYmdHms(targetSolar.getYear(), targetSolar.getMonth(), targetSolar.getDay(), i*2, 0, 0);
        const l = Lunar.fromSolar(s);
        const gz = l.getEightChar().getTime();
        lsRows += `<tr><td>${TIME_LABEL[i]}</td><td>${ZHI_TIME[i]}</td><td><span class="gz">${gz}</span></td></tr>`;
      }
      document.getElementById('lp-liushi').innerHTML =
        `<thead><tr><th>Window</th><th>Branch</th><th>Pillar</th></tr></thead><tbody>${lsRows}</tbody>`;

      const ec2 = Lunar.fromSolar(birthSolar).getEightChar();
      const taiyuan = ec2.getTaiYuan();
      const minggong = ec2.getMingGong();
      const shengong = ec2.getShenGong();
      document.getElementById('lp-taiyuan').innerHTML = `Tai Yuan <span class="gz">${taiyuan}</span> <span class="nayin">${nayinOf(taiyuan)}</span>`;
      document.getElementById('lp-minggong').innerHTML = `Ming Gong <span class="gz">${minggong}</span> <span class="nayin">${nayinOf(minggong)}</span>`;
      document.getElementById('lp-shengong').innerHTML = `Shen Gong <span class="gz">${shengong}</span> <span class="nayin">${nayinOf(shengong)}</span>`;

      const relList = [
        { l: 'Yr', z: data.year[1] }, { l: 'Mo', z: data.month[1] }, { l: 'Dy', z: data.day[1] },
        { l: 'Hr', z: data.time[1] }, { l: 'Yun', z: data.currentDaYun[1] }, { l: 'Liu', z: data.currentLiuNian[1] }
      ];
      document.getElementById('lp-relations').innerHTML = computeRelationsEN(relList);

      const interpEl = document.getElementById('lp-interp');
      if (interpEl) interpEl.innerHTML = interpret(data, dayGan, dayZhi);
    }

    document.getElementById('lp-btn').addEventListener('click', function () {
      const lunarTag = document.querySelector('script[src$="lunar.js"]');
      const base = (lunarTag && lunarTag.src.match(/(.*\/)lunar\.js$/)) ? RegExp.$1 : '/';
      if (window.MingLiPay && !MingLiPay.isUnlocked()) {
        MingLiPay.showPayModal({
          qrWechat: base + 'reward/wechat.png',
          qrAlipay: base + 'reward/alipay.png',
          minTip: 1,
          unlockCode: btoa('mingli2026')
        }, function () { render(); });
        return;
      }
      render();
    });

    const now = new Date();
    setupDate('lp', 1990, 6, 15);
    setupTime('lp', 12, 0);
    setupDate('tg', now.getFullYear(), now.getMonth() + 1, now.getDate());
    setupTime('tg', now.getHours(), now.getMinutes());
  </script>
