---
import BlogPost from '../../layouts/BlogPost.astro';
const base = import.meta.env.BASE_URL;
---

<BlogPost title="Natal Chart" description="Enter your birth time and gender to cast the four pillars, the Ten Gods pattern, the five-element strength, the day-master strength, and a readable BaZi chart reading." lang="en" altLang="中文" altHref="/mingpan">
  <p class="lead">Enter your birth date, time and gender to cast the four pillars, the Ten Gods pattern, the five-element strength, the day-master strength and the luck-pillar trend, then generate a readable natal-chart reading.</p>
  <p class="disclaimer">⚠️ For entertainment and cultural interest only. Not advice on life, investment or health.</p>

  <section class="tool-card">
    <h2>📝 Birth details</h2>
    <div class="tool-form">
      <label class="date-label">Birth date
        <span class="date-selects">
          <select id="mp-year"></select><i>Y</i>
          <select id="mp-month"></select><i>M</i>
          <select id="mp-day"></select><i>D</i>
        </span>
      </label>
      <label class="date-label">Birth time
        <span class="time-selects">
          <select id="mp-hour"></select><i>h</i>
          <select id="mp-min"></select><i>m</i>
        </span>
      </label>
      <label>Gender
        <select id="mp-gender">
          <option value="1">Male</option>
          <option value="2">Female</option>
        </select>
      </label>
      <button id="mp-btn" class="tool-btn" type="button">Cast chart</button>
    </div>
  </section>

  <div id="mp-result" hidden>
    <section class="tool-card chart-card">
      <h2>🧭 Four Pillars</h2>
      <div id="mp-summary"></div>
      <div class="table-wrap">
        <table class="mp-table" id="mp-pillars">
          <thead><tr><th></th><th>Year</th><th>Month</th><th>Day</th><th>Hour</th></tr></thead>
          <tbody>
            <tr><th>Stem-Branch</th><td id="mp-y-gz"></td><td id="mp-m-gz"></td><td id="mp-d-gz"></td><td id="mp-h-gz"></td></tr>
            <tr><th>Ten Gods</th><td id="mp-y-ss"></td><td id="mp-m-ss"></td><td id="mp-d-ss"></td><td id="mp-h-ss"></td></tr>
            <tr><th>Element</th><td id="mp-y-wx"></td><td id="mp-m-wx"></td><td id="mp-d-wx"></td><td id="mp-h-wx"></td></tr>
            <tr><th>Nayin</th><td id="mp-y-ny"></td><td id="mp-m-ny"></td><td id="mp-d-ny"></td><td id="mp-h-ny"></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="tool-card">
      <h2>🌡️ Element Strength</h2>
      <div id="mp-wuxing"></div>
    </section>

    <section class="tool-card">
      <h2>💪 Day-Master Strength</h2>
      <div id="mp-strength"></div>
    </section>

    <section class="tool-card">
      <h2>🧩 Ten Gods Pattern</h2>
      <div id="mp-pattern"></div>
    </section>

    <section class="tool-card">
      <h2>🌊 Luck-Pillar Trend</h2>
      <div id="mp-dayun"></div>
    </section>

    <section class="tool-card">
      <h2>📜 Reading</h2>
      <div id="mp-read"></div>
    </section>
  </div>

  <p style="margin-top: 24px;"><a href={`${base}en/tools`}>← Back to the toolkit</a></p>

  <style>
    .lead { color: var(--muted); font-size: 16px; }
    .disclaimer { background: var(--code-bg); border: 1px dashed var(--border); border-radius: 8px; padding: 10px 14px; font-size: 13px; color: var(--muted); }
    .tool-card { border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; margin: 20px 0; background: var(--bg); }
    .tool-card h2 { margin-top: 0; border-left: 4px solid var(--accent); padding-left: 10px; }
    .chart-card { padding: 0; overflow: hidden; }
    .chart-card h2 { margin: 18px 20px 0; }
    .chart-card #mp-summary { margin: 8px 20px 12px; }
    .tool-form { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; margin-top: 10px; }
    .tool-form label { font-size: 14px; color: var(--fg); display: flex; flex-direction: column; gap: 4px; }
    .tool-form select { padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--fg); font-size: 14px; }
    .date-label { font-size: 14px; color: var(--fg); display: flex; flex-direction: column; gap: 4px; }
    .date-selects, .time-selects { display: inline-flex; align-items: center; gap: 5px; flex-wrap: wrap; }
    .date-selects select, .time-selects select { padding: 8px 6px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--fg); font-size: 14px; }
    .date-selects i, .time-selects i { font-style: normal; color: var(--muted); font-size: 14px; }
    .tool-btn { padding: 9px 18px; border: 1px solid var(--accent); background: var(--accent); color: #fff; border-radius: 8px; cursor: pointer; font-size: 14px; transition: transform .15s, opacity .15s; }
    .tool-btn:hover { transform: translateY(-1px); opacity: .92; }
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; padding: 0 20px 20px; }
    .mp-table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 520px; }
    .mp-table th, .mp-table td { border: 1px solid var(--border); padding: 8px 5px; text-align: center; }
    .mp-table thead th { background: var(--code-bg); color: var(--muted); font-size: 13px; }
    .mp-table tbody th { background: var(--code-bg); color: var(--muted); font-size: 13px; }
    .gz { font-size: 18px; font-weight: 700; color: var(--accent); }
    .ss { font-size: 13px; font-weight: 600; }
    .wx { font-size: 12px; color: var(--muted); }
    .ny { font-size: 11px; color: var(--muted); }
    .wx-bar { display: flex; align-items: center; gap: 8px; margin: 6px 0; font-size: 14px; }
    .wx-bar .wx-name { width: 28px; color: var(--fg); }
    .wx-bar .wx-track { flex: 1; height: 14px; background: var(--code-bg); border-radius: 999px; overflow: hidden; }
    .wx-bar .wx-fill { height: 100%; background: var(--accent); border-radius: 999px; }
    .wx-bar .wx-val { width: 28px; text-align: right; color: var(--muted); font-size: 13px; }
    .mp-read p { line-height: 1.85; margin: 8px 0; }
    .mp-read b { color: var(--accent); }
    .mp-tag { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 13px; background: rgba(124,92,255,0.12); color: var(--accent); margin-right: 6px; }
  </style>

  <script is:inline src={`${base}lunar.js`}></script>
  <script is:inline src={`${base}paywall.js`}></script>
  <script is:inline>
    const ZHI_CANG = {
      '子': '癸', '丑': '己癸辛', '寅': '甲丙戊', '卯': '乙', '辰': '戊乙癸', '巳': '丙戊庚',
      '午': '丁己', '未': '己丁乙', '申': '庚壬戊', '酉': '辛', '戌': '戊辛丁', '亥': '壬甲'
    };
    const GAN_WUXING = {甲:'木',乙:'木',丙:'火',丁:'火',戊:'土',己:'土',庚:'金',辛:'金',壬:'水',癸:'水'};
    const GAN_YINYANG = {甲:'阳',乙:'阴',丙:'阳',丁:'阴',戊:'阳',己:'阴',庚:'阳',辛:'阴',壬:'阳',癸:'阴'};
    const WUXING_SHENG = {木:'火',火:'土',土:'金',金:'水',水:'木'};
    const WUXING_KE = {木:'土',土:'水',水:'火',火:'金',金:'木'};
    const NAYIN = {
      '甲子':'海中金','乙丑':'海中金','丙寅':'炉中火','丁卯':'炉中火','戊辰':'大林木','己巳':'大林木',
      '庚午':'路旁土','辛未':'路旁土','壬申':'剑锋金','癸酉':'剑锋金','甲戌':'山头火','乙亥':'山头火',
      '丙子':'涧下水','丁丑':'涧下水','戊寅':'城头土','己卯':'城头土','庚辰':'白蜡金','辛巳':'白蜡金',
      '壬午':'杨柳木','癸未':'杨柳木','甲申':'泉中水','乙酉':'泉中水','丙戌':'屋上土','丁亥':'屋上土',
      '戊子':'霹雳火','己丑':'霹雳火','庚寅':'松柏木','辛卯':'松柏木','壬辰':'长流水','癸巳':'长流水',
      '甲午':'沙中金','乙未':'沙中金','丙申':'山下火','丁酉':'山下火','戊戌':'平地木','己亥':'平地木',
      '庚子':'壁上土','辛丑':'壁上土','壬寅':'金箔金','癸卯':'金箔金','甲辰':'覆灯火','乙巳':'覆灯火',
      '丙午':'天河水','丁未':'天河水','戊申':'大驿土','己酉':'大驿土','庚戌':'钗钏金','辛亥':'钗钏金',
      '壬子':'桑柘木','癸丑':'桑柘木','甲寅':'大溪水','乙卯':'大溪水','丙辰':'沙中土','丁巳':'沙中土',
      '戊午':'天上火','己未':'天上火','庚申':'石榴木','辛酉':'石榴木','壬戌':'大海水','癸亥':'大海水'
    };

    const WX_ORDER = ['木','火','土','金','水'];
    const WX_COLOR = {木:'#3aa76d',火:'#e0533d',土:'#c79a4b',金:'#b0b6bd',水:'#3d7fe0'};

    function shiShen(dayGan, targetGan) {
      if (dayGan === targetGan) return '日主';
      const dw = GAN_WUXING[dayGan], tw = GAN_WUXING[targetGan];
      const dy = GAN_YINYANG[dayGan], ty = GAN_YINYANG[targetGan];
      const same = dy === ty;
      if (dw === tw) return same ? '比肩' : '劫财';
      if (WUXING_SHENG[dw] === tw) return same ? '食神' : '伤官';
      if (WUXING_KE[dw] === tw) return same ? '偏财' : '正财';
      if (WUXING_SHENG[tw] === dw) return same ? '偏印' : '正印';
      if (WUXING_KE[tw] === dw) return same ? '七杀' : '正官';
      return '';
    }

    const WX_NATURE = {
      木: 'benevolent, upward-reaching and principled — you grow toward the light like a tree.',
      火: 'passionate, outgoing and expressive — you warm and brighten those around you.',
      土: 'trustworthy,包容 and steady — you hold and nourish like the earth.',
      金: 'resolute, decisive and principled — you would rather bend than break.',
      水: 'wise, fluid and adaptable — you follow the terrain like a river.'
    };

    function fillDayOptions(ySel, mSel, dSel, defD) {
      const y = +ySel.value, m = +mSel.value;
      const max = new Date(y, m, 0).getDate();
      dSel.innerHTML = '';
      for (let d = 1; d <= max; d++) {
        const o = document.createElement('option');
        o.value = d; o.textContent = d;
        if (d === defD) o.selected = true;
        dSel.appendChild(o);
      }
    }
    function setupDate(prefix, defY, defM, defD) {
      const ySel = document.getElementById(prefix + '-year');
      const mSel = document.getElementById(prefix + '-month');
      const dSel = document.getElementById(prefix + '-day');
      const START = 1920, END = 2035;
      if (!ySel || !mSel || !dSel) return;
      for (let y = END; y >= START; y--) { const o = document.createElement('option'); o.value = y; o.textContent = y; if (y === defY) o.selected = true; ySel.appendChild(o); }
      for (let m = 1; m <= 12; m++) { const o = document.createElement('option'); o.value = m; o.textContent = m; if (m === defM) o.selected = true; mSel.appendChild(o); }
      fillDayOptions(ySel, mSel, dSel, defD);
      ySel.addEventListener('change', () => fillDayOptions(ySel, mSel, dSel, +dSel.value || 1));
      mSel.addEventListener('change', () => fillDayOptions(ySel, mSel, dSel, +dSel.value || 1));
    }
    function readDate(prefix) {
      const y = +document.getElementById(prefix + '-year').value;
      const m = +document.getElementById(prefix + '-month').value;
      const d = +document.getElementById(prefix + '-day').value;
      if (!y || !m || !d) return null;
      return { y, m, d };
    }
    function setupTime(prefix, defH, defM) {
      const hSel = document.getElementById(prefix + '-hour');
      const mSel = document.getElementById(prefix + '-min');
      if (!hSel || !mSel) return;
      for (let h = 0; h < 24; h++) { const o = document.createElement('option'); o.value = h; o.textContent = h; if (h === defH) o.selected = true; hSel.appendChild(o); }
      for (let m = 0; m < 60; m++) { const o = document.createElement('option'); o.value = String(m).padStart(2,'0'); o.textContent = String(m).padStart(2,'0'); if (m === defM) o.selected = true; mSel.appendChild(o); }
    }
    function readTime(prefix) {
      const h = +document.getElementById(prefix + '-hour').value;
      const m = +document.getElementById(prefix + '-min').value;
      return { h, m };
    }

    function computeWuxing(pillars, dayGan) {
      const count = {木:0,火:0,土:0,金:0,水:0};
      pillars.forEach(p => {
        count[GAN_WUXING[p.gan]] += 1;
        const benqi = ZHI_CANG[p.zhi][0];
        count[GAN_WUXING[benqi]] += 1;
      });
      return count;
    }

    function strengthScore(pillars, dayGan, dayZhi) {
      const dwx = GAN_WUXING[dayGan];
      let score = 0;
      const monthZhi = pillars[1].zhi;
      const mb = ZHI_CANG[monthZhi];
      if (GAN_WUXING[mb[0]] === dwx) score += 2;
      else if (mb.includes(GAN_WUXING[dwx === '木' ? '甲' : dwx === '火' ? '丙' : dwx === '土' ? '戊' : dwx === '金' ? '庚' : '壬'])) score += 1;
      pillars.forEach(p => { if (GAN_WUXING[ZHI_CANG[p.zhi][0]] === dwx) score += 1; });
      pillars.forEach(p => {
        const ss = shiShen(dayGan, p.gan);
        if (ss === '正印' || ss === '偏印') score += 1;
        if (ss === '比肩' || ss === '劫财') score += 1;
      });
      return score;
    }

    function render() {
      const p = readDate('mp');
      if (!p) { alert('Please select a birth date.'); return; }
      const { h: hh, m: mm } = readTime('mp');
      const gender = +document.getElementById('mp-gender').value;
      const solar = Solar.fromYmdHms(p.y, p.m, p.d, hh, mm, 0);
      const lunar = Lunar.fromSolar(solar);
      const ec = lunar.getEightChar();
      const yGZ = ec.getYear(), mGZ = ec.getMonth(), dGZ = ec.getDay(), tGZ = ec.getTime();
      const dayGan = dGZ[0], dayZhi = dGZ[1];

      const pillars = [
        { label: 'Year', gan: yGZ[0], zhi: yGZ[1] },
        { label: 'Month', gan: mGZ[0], zhi: mGZ[1] },
        { label: 'Day', gan: dGZ[0], zhi: dGZ[1] },
        { label: 'Hour', gan: tGZ[0], zhi: tGZ[1] }
      ];

      document.getElementById('mp-result').hidden = false;
      document.getElementById('mp-summary').innerHTML =
        `<p><b>${p.y}-${String(p.m).padStart(2,'0')}-${String(p.d).padStart(2,'0')} ${String(hh).padStart(2,'0')}:${String(mm).padStart(2,'0')}</b> · ${gender === 1 ? 'Male' : 'Female'} · Day Master <span class="gz">${dayGan}${dayZhi}</span></p>`;

      const gzIds = ['mp-y', 'mp-m', 'mp-d', 'mp-h'];
      pillars.forEach((pl, i) => {
        const id = gzIds[i];
        const ss = shiShen(dayGan, pl.gan);
        document.getElementById(id + '-gz').innerHTML = `<span class="gz">${pl.gan}${pl.zhi}</span>`;
        document.getElementById(id + '-ss').innerHTML = `<span class="ss">${ss}</span>`;
        document.getElementById(id + '-wx').innerHTML = `<span class="wx">${GAN_WUXING[pl.gan]}${GAN_WUXING[ZHI_CANG[pl.zhi][0]]}</span>`;
        document.getElementById(id + '-ny').innerHTML = `<span class="ny">${NAYIN[pl.gan + pl.zhi]}</span>`;
      });

      const wx = computeWuxing(pillars, dayGan);
      const maxWx = Math.max(...WX_ORDER.map(k => wx[k]), 1);
      const wxHtml = WX_ORDER.map(k =>
        `<div class="wx-bar"><span class="wx-name">${k}</span>` +
        `<span class="wx-track"><span class="wx-fill" style="width:${Math.round(wx[k] / maxWx * 100)}%;background:${WX_COLOR[k]}"></span></span>` +
        `<span class="wx-val">${wx[k]}</span></div>`
      ).join('');
      document.getElementById('mp-wuxing').innerHTML = wxHtml +
        `<p style="font-size:13px;color:var(--muted);margin-top:10px">Elements counted from the four heavenly stems and the ground-branch core qi (1 each); higher = stronger element in this chart.</p>`;

      const score = strengthScore(pillars, dayGan, dayZhi);
      let level, tip;
      if (score >= 7) { level = 'Strong'; tip = 'The day master is well supported (season, location, nurture, allies), so you act with agency — balance with output, wealth and structure; if too strong, moderate it.'; }
      else if (score <= 4) { level = 'Weak'; tip = 'The day master has less support — lean on nurture and allies (resource/peer stars), and borrow team and elder strength when needed.'; }
      else { level = 'Balanced'; tip = 'The day master is relatively balanced and adaptable; the useful element is flexible, and you handle both ups and downs.'; }
      document.getElementById('mp-strength').innerHTML =
        `<p>Strength score: <b>${score}</b> / 10 → <span class="mp-tag">${level}</span></p>` +
        `<p style="font-size:14px;color:var(--fg)">${tip}</p>`;

      const ssList = pillars.map(pl => shiShen(dayGan, pl.gan)).filter(s => s && s !== '日主');
      const tally = {};
      ssList.forEach(s => { tally[s] = (tally[s] || 0) + 1; });
      const sorted = Object.entries(tally).sort((a, b) => b[1] - a[1]);
      const monthSS = shiShen(dayGan, mGZ[0]);
      const topSS = sorted.length ? sorted[0][0] : '—';
      const patternText = monthSS !== '日主'
        ? `The pattern core is the month-pillar Ten God <b>「${monthSS}」</b>; overall the「${topSS}」star is most prominent.`
        : `The month stem shares the day master's qi; the pattern leans on the day master's own momentum, with the branches setting strength.`;
      document.getElementById('mp-pattern').innerHTML =
        `<p>${patternText}</p>` +
        `<p style="font-size:13px;color:var(--muted)">Ten Gods tally: ${sorted.map(([k, v]) => `${k}×${v}`).join(', ') || '—'}</p>` +
        `<p style="font-size:13px;color:var(--muted)">Ten Gods are each pillar's stem relation to the day master: peers = siblings/allies, output = talent/expression, wealth = resources, officer = career/structure, resource = learning/support.</p>`;

      const yun = ec.getYun(gender);
      const startAge = yun.getStartAge();
      const dayun = yun.getDaYun();
      const curYear = new Date().getFullYear();
      let cur = dayun.slice(1).find(d => {
        const s = d.getStartYear();
        const idx = dayun.indexOf(d);
        const e = idx < dayun.length - 1 ? dayun[idx + 1].getStartYear() : s + 10;
        return curYear >= s && curYear < e;
      }) || dayun[dayun.length - 1];
      const curGZ = cur.getGanZhi();
      const curSS = shiShen(dayGan, curGZ[0]);
      const dyRows = dayun.slice(1).map(d => {
        const gz = d.getGanZhi();
        const s = d.getStartYear();
        const a = d.getStartAge();
        const isCur = gz === curGZ;
        return `<tr class="${isCur ? 'current' : ''}"><td>${s}–${s + 9}</td><td>${a}–${a + 9}</td><td><span class="gz">${gz}</span></td><td>${shiShen(dayGan, gz[0])}</td></tr>`;
      }).join('');
      document.getElementById('mp-dayun').innerHTML =
        `<p>Luck activation: about <b>${startAge}</b> years old.</p>` +
        `<p>Current luck pillar: <span class="mp-tag">${curGZ}</span> Ten God「${curSS}」—${curSS === '正财' || curSS === '偏财' ? 'favors resource building and pragmatic operation' : curSS === '正官' || curSS === '七杀' ? 'career stage with pressure and a platform — earn trust by delivering' : curSS === '食神' || curSS === '伤官' ? 'talent and expression get seen — good for creative output' : curSS === '正印' || curSS === '偏印' ? 'favors study, depth and elder support' : curSS === '比肩' || curSS === '劫财' ? 'more collaboration and networking' : 'a smooth transition'}.</p>` +
        `<div class="table-wrap" style="padding:0"><table class="mp-table"><thead><tr><th>Years</th><th>Age</th><th>Stem-Branch</th><th>Ten God</th></tr></thead><tbody>${dyRows}</tbody></table></div>`;

      const dwx = GAN_WUXING[dayGan];
      const strengthWord = level === 'Strong' ? 'full of drive' : level === 'Weak' ? 'better by leveraging others' : 'measured in approach';
      document.getElementById('mp-read').innerHTML =
        `<p><span class="mp-tag">${dwx} day master</span> You are naturally ${WX_NATURE[dwx]} The day master is ${strengthWord}, the base tone of this chart.</p>` +
        `<p><b>Character:</b> ${WX_NATURE[dwx]} The ${dwx} element is ${wx[dwx] >= 3 ? 'strong' : 'moderate'} here; strength is「${level}」, meaning ${tip}</p>` +
        `<p><b>Career:</b> The month-pillar core is「${monthSS}」, favoring ${monthSS === '正官' || monthSS === '七杀' ? 'rules, management and accountability' : monthSS === '正财' || monthSS === '偏财' ? 'pragmatic operation and resource play' : monthSS === '食神' || monthSS === '伤官' ? 'creativity, expression and craft' : monthSS === '正印' || monthSS === '偏印' ? 'study, research and expertise' : monthSS === '比肩' || monthSS === '劫财' ? 'collaboration, partnership and network' : 'all-round polishing'}; the current luck pillar「${curGZ}（${curSS}）」adds to it.</p>` +
        `<p><b>Wealth:</b> The wealth stars (正财/偏财) appear ${ssList.filter(s => s === '正财' || s === '偏财').length} times — ${ssList.includes('偏财') ? 'flexible side income and opportunity-type gains' : 'mainly steady earned income'}; read yearly chances against the current luck pillar.</p>` +
        `<p><b>Relationship:</b> For males the wealth star is the spouse star, for females the officer star is; the ${gender === 1 ? 'wealth' : 'officer'} star's visibility shapes the dynamic, with「${topSS}」as the base tone — a partner who complements your weak element helps.</p>` +
        `<p><b>Health:</b> The ${WX_ORDER.slice().sort((a, b) => wx[a] - wx[b])[0]} element is weakest — correspondences: 木 liver, 火 heart, 土 spleen/stomach, 金 lungs, 水 kidneys; this is entertainment analogy only — rely on medical checks for health.</p>` +
