---
import BlogPost from '../../layouts/BlogPost.astro';
const base = import.meta.env.BASE_URL;
---

<BlogPost title="Divination Toolkit" description="Birth date → zodiac · couple synastry · birth calendar · time-progression chart" lang="en" altLang="中文" altHref="/tools">
  <p class="lead">Five client-side mini tools, ready to use: find your Sun sign, score a couple's compatibility, cast the four birth pillars, generate a dynamic time-progression chart, and read a deep Bazi natal chart.</p>
  <p class="disclaimer">⚠️ For entertainment and cultural curiosity only — not life, financial, or health advice.</p>

  <section class="tool-card">
    <h2>🔮 Zodiac Finder</h2>
    <p>Enter your birth date to reveal your Sun sign and ruling element.</p>
    <div class="tool-form">
      <label class="date-label">Birth date
        <span class="date-selects">
          <select id="zx-year"></select><i>Y</i>
          <select id="zx-month"></select><i>M</i>
          <select id="zx-day"></select><i>D</i>
        </span>
      </label>
      <button id="zx-btn" class="tool-btn" type="button">Find</button>
    </div>
    <div id="zx-result" class="tool-result" hidden></div>
  </section>

  <section class="tool-card">
    <h2>💞 Synastry</h2>
    <p>Two birth dates, a simple element-based compatibility score.</p>
    <div class="tool-form">
      <label class="date-label">Person A
        <span class="date-selects">
          <select id="hp-a-year"></select><i>Y</i>
          <select id="hp-a-month"></select><i>M</i>
          <select id="hp-a-day"></select><i>D</i>
        </span>
      </label>
      <label class="date-label">Person B
        <span class="date-selects">
          <select id="hp-b-year"></select><i>Y</i>
          <select id="hp-b-month"></select><i>M</i>
          <select id="hp-b-day"></select><i>D</i>
        </span>
      </label>
      <button id="hp-btn" class="tool-btn" type="button">Match</button>
    </div>
    <div id="hp-result" class="tool-result" hidden></div>
  </section>

  <section class="tool-card">
    <h2>🌙 Birth Calendar</h2>
    <p>Enter your birth date and time to cast the four pillars (year, month, day, hour) and birth solar term.</p>
    <div class="tool-form">
      <label class="date-label">Birth date
        <span class="date-selects">
          <select id="sc-year"></select><i>Y</i>
          <select id="sc-month"></select><i>M</i>
          <select id="sc-day"></select><i>D</i>
        </span>
      </label>
      <label class="date-label">Birth time
        <span class="time-selects">
          <select id="sc-hour"></select><i>h</i>
          <select id="sc-min"></select><i>m</i>
        </span>
      </label>
      <button id="sc-btn" class="tool-btn" type="button">Cast</button>
    </div>
    <div id="sc-result" class="tool-result" hidden></div>
  </section>

  <section class="tool-card">
    <h2>🌊 Time-Progression Chart</h2>
    <p>Enter your birth details to generate a dynamic chart of Da Yun, Liu Nian, Liu Yue, Liu Ri, and Liu Shi.</p>
    <div class="tool-form">
      <a class="tool-btn" href={`${base}en/liupan`} id="lp-link">Open chart</a>
    </div>
    <p class="tool-note">💝 A tip is required before casting (min ¥1, no upper limit); the author is exempt.</p>
  </section>

  <section class="tool-card">
    <h2>🧭 Natal Chart</h2>
    <p>Enter your birth details and gender for a deep Bazi reading: four-pillar overview, Five-Element strength, Day-Master score, Ten Gods pattern, Da Yun trend, plus a synthesized read on character, career, wealth, love and health.</p>
    <div class="tool-form">
      <a class="tool-btn" href={`${base}en/mingpan`} id="mp-link">Open chart</a>
    </div>
    <p class="tool-note">💝 A tip is required before reading (min ¥1, no upper limit); the author is exempt.</p>
  </section>

  <style>
    .lead { color: var(--muted); font-size: 16px; }
    .disclaimer { background: var(--code-bg); border: 1px dashed var(--border); border-radius: 8px; padding: 10px 14px; font-size: 13px; color: var(--muted); }
    .tool-card { border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; margin: 20px 0; background: var(--bg); }
    .tool-card h2 { margin-top: 0; border-left: 4px solid var(--accent); padding-left: 10px; }
    .tool-form { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; margin-top: 10px; }
    .tool-form label { font-size: 14px; color: var(--fg); display: flex; flex-direction: column; gap: 4px; }
    .tool-form input { padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--fg); font-size: 14px; }
    .date-label { font-size: 14px; color: var(--fg); display: flex; flex-direction: column; gap: 4px; }
    .date-selects, .time-selects { display: inline-flex; align-items: center; gap: 5px; flex-wrap: wrap; }
    .date-selects select, .time-selects select { padding: 8px 6px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--fg); font-size: 14px; }
    .date-selects i, .time-selects i { font-style: normal; color: var(--muted); font-size: 14px; }
    .tool-btn { padding: 9px 18px; border: 1px solid var(--accent); background: var(--accent); color: #fff; border-radius: 8px; cursor: pointer; font-size: 14px; transition: transform .15s, opacity .15s; }
    .tool-btn:hover { transform: translateY(-1px); opacity: .92; }
    .tool-note { font-size: 12px; color: var(--muted); margin: 10px 0 0; }
    .tool-result { margin-top: 16px; padding: 16px; border-radius: 10px; background: var(--code-bg); border: 1px solid var(--border); line-height: 1.8; }
    .tool-result h3 { margin: 0 0 8px; font-size: 20px; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 13px; background: rgba(124,92,255,0.12); color: var(--accent); margin-right: 6px; }
    .score-ring { font-size: 40px; font-weight: 700; color: var(--accent); }
    .sc-card { display: flex; gap: 16px; align-items: center; }
    .sc-emoji { font-size: 56px; }
    .sc-meta b { color: var(--accent); }
    .pillar-table { width: 100%; border-collapse: collapse; margin-top: 14px; font-size: 15px; }
    .pillar-table th, .pillar-table td { border: 1px solid var(--border); padding: 10px; text-align: center; }
    .pillar-table th { background: var(--code-bg); color: var(--muted); font-size: 13px; }
    .pillar-table td { font-size: 20px; font-weight: 700; color: var(--accent); }
  </style>

  <script is:inline src={`${base}lunar.js`}></script>
  <script is:inline>
    const SIGNS = [
      { name: '白羊座', en: 'Aries', sym: '♈', start: [3, 21], end: [4, 19], el: '火', elEn: 'Fire', planet: 'Mars', traits: 'passionate, impulsive, action-first' },
      { name: '金牛座', en: 'Taurus', sym: '♉', start: [4, 20], end: [5, 20], el: '土', elEn: 'Earth', planet: 'Venus', traits: 'steady, pragmatic, aesthetic' },
      { name: '双子座', en: 'Gemini', sym: '♊', start: [5, 21], end: [6, 20], el: '风', elEn: 'Air', planet: 'Mercury', traits: 'witty, changeable, curious' },
      { name: '巨蟹座', en: 'Cancer', sym: '♋', start: [6, 21], end: [7, 22], el: '水', elEn: 'Water', planet: 'Moon', traits: 'homely, sensitive, nostalgic' },
      { name: '狮子座', en: 'Leo', sym: '♌', start: [7, 23], end: [8, 22], el: '火', elEn: 'Fire', planet: 'Sun', traits: 'confident, generous, expressive' },
      { name: '处女座', en: 'Virgo', sym: '♍', start: [8, 23], end: [9, 22], el: '土', elEn: 'Earth', planet: 'Mercury', traits: 'detail-oriented, perfectionist' },
      { name: '天秤座', en: 'Libra', sym: '♎', start: [9, 23], end: [10, 23], el: '风', elEn: 'Air', planet: 'Venus', traits: 'graceful, balanced, conflict-averse' },
      { name: '天蝎座', en: 'Scorpio', sym: '♏', start: [10, 24], end: [11, 22], el: '水', elEn: 'Water', planet: 'Pluto', traits: 'intense, focused, possessive' },
      { name: '射手座', en: 'Sagittarius', sym: '♐', start: [11, 23], end: [12, 21], el: '火', elEn: 'Fire', planet: 'Jupiter', traits: 'free, optimistic, explorative' },
      { name: '摩羯座', en: 'Capricorn', sym: '♑', start: [12, 22], end: [1, 19], el: '土', elEn: 'Earth', planet: 'Saturn', traits: 'disciplined, resilient, ambitious' },
      { name: '水瓶座', en: 'Aquarius', sym: '♒', start: [1, 20], end: [2, 18], el: '风', elEn: 'Air', planet: 'Uranus', traits: 'independent, rational, rebellious' },
      { name: '双鱼座', en: 'Pisces', sym: '♓', start: [2, 19], end: [3, 20], el: '水', elEn: 'Water', planet: 'Neptune', traits: 'romantic, empathic, dreamy' },
    ];
    function getSign(m, d) {
      for (const s of SIGNS) {
        const [sm, sd] = s.start, [em, ed] = s.end;
        if (sm < em) {
          if ((m === sm && d >= sd) || (m === em && d <= ed) || (m > sm && m < em)) return s;
        } else {
          if ((m === sm && d >= sd) || (m === em && d <= ed) || m < em || m > sm) return s;
        }
      }
      return SIGNS[0];
    }

    const ELEM_PAIR = {
      '火-火': 92, '土-土': 86, '风-风': 86, '水-水': 86,
      '火-风': 90, '风-火': 90, '土-水': 90, '水-土': 90,
      '火-土': 72, '土-火': 72, '风-水': 70, '水-风': 70,
      '火-水': 66, '水-火': 66, '风-土': 74, '土-风': 74,
    };
    function pairScore(e1, e2) { return ELEM_PAIR[e1 + '-' + e2] ?? ELEM_PAIR[e2 + '-' + e1] ?? 70; }
    function pairText(score) {
      if (score >= 90) return 'Cosmic match — elements feed each other, same frequency, the pull only grows.';
      if (score >= 82) return 'Very compatible — similar rhythm, low friction, built for the long run.';
      if (score >= 72) return 'Complementary pair — attraction plus minor friction; communication is the key.';
      return 'Differences create tension — both spark and test; more patience from both sides.';
    }

    const ANIMALS = ['鼠', '牛', '虎', '兔', '龙', '蛇', '马', '羊', '猴', '鸡', '狗', '猪'];
    const AEMOJI = ['🐭', '🐂', '🐯', '🐰', '🐲', '🐍', '🐴', '🐑', '🐵', '🐔', '🐶', '🐷'];
    function sx(y) { return ANIMALS[(((y - 4) % 12) + 12) % 12]; }
    function sxEmoji(y) { return AEMOJI[(((y - 4) % 12) + 12) % 12]; }
    const SC_LINES = {
      '鼠': 'Sharp and flexible, great at seizing chances — network widely.',
      '牛': 'Diligent and steady, slow buildup pays off — persistence wins.',
      '虎': 'Bold and commanding, natural leader — temper the edge.',
      '兔': 'Gentle and tactful, well-liked — avoid overthinking.',
      '龙': 'Charismatic with innate nobility — ready for big roles.',
      '蛇': 'Calm and clever, plans before acting — hides the blade.',
      '马': 'Free-spirited and warm — keep a steady pace.',
      '羊': 'Tender and loyal — build your own convictions.',
      '猴': 'Quick-witted and inventive — master one craft deeply.',
      '鸡': 'Sharp and practical, cares about image — drop the pettiness.',
      '狗': 'Loyal and trustworthy — learn to let go.',
      '猪': 'Easygoing and lucky — keep your boundaries.',
    };

    function fillDayOptions(ySel, mSel, dSel, defD) {
      const y = +ySel.value, m = +mSel.value;
      const max = new Date(y, m, 0).getDate();
      dSel.innerHTML = '';
      for (let d = 1; d <= max; d++) {
        const o = document.createElement('option');
        o.value = d; o.textContent = d;
        if (d === defD) o.selected = true;
        dSel.appendChild(o);
      }
    }
    function setupDate(prefix, defY, defM, defD) {
      const ySel = document.getElementById(prefix + '-year');
      const mSel = document.getElementById(prefix + '-month');
      const dSel = document.getElementById(prefix + '-day');
      const START = 1920, END = 2025;
      if (!ySel || !mSel || !dSel) return;
      for (let y = END; y >= START; y--) { const o = document.createElement('option'); o.value = y; o.textContent = y; if (y === defY) o.selected = true; ySel.appendChild(o); }
      for (let m = 1; m <= 12; m++) { const o = document.createElement('option'); o.value = m; o.textContent = m; if (m === defM) o.selected = true; mSel.appendChild(o); }
      fillDayOptions(ySel, mSel, dSel, defD);
      ySel.addEventListener('change', () => fillDayOptions(ySel, mSel, dSel, defD));
      mSel.addEventListener('change', () => fillDayOptions(ySel, mSel, dSel, defD));
    }
    function readDate(prefix) {
      const y = +document.getElementById(prefix + '-year').value;
      const m = +document.getElementById(prefix + '-month').value;
      const d = +document.getElementById(prefix + '-day').value;
      if (!y || !m || !d) return null;
      return { y, m, d };
    }
    function setupTime(prefix, defH, defM) {
      const hSel = document.getElementById(prefix + '-hour');
      const mSel = document.getElementById(prefix + '-min');
      if (!hSel || !mSel) return;
      for (let h = 0; h < 24; h++) { const o = document.createElement('option'); o.value = h; o.textContent = h; if (h === defH) o.selected = true; hSel.appendChild(o); }
      for (let m = 0; m < 60; m++) { const o = document.createElement('option'); o.value = String(m).padStart(2, '0'); o.textContent = String(m).padStart(2, '0'); if (m === defM) o.selected = true; mSel.appendChild(o); }
    }
    function readTime(prefix) {
      const h = +document.getElementById(prefix + '-hour').value;
      const m = +document.getElementById(prefix + '-min').value;
      return { h, m };
    }

    // Tool 1: Zodiac Finder
    const zxBtn = document.getElementById('zx-btn');
    const zxOut = document.getElementById('zx-result');
    zxBtn.addEventListener('click', () => {
      const p = readDate('zx');
      if (!p) { zxOut.hidden = false; zxOut.textContent = 'Please pick a birth date.'; return; }
      const s = getSign(p.m, p.d);
      zxOut.hidden = false;
      zxOut.innerHTML =
        `<h3>${s.sym} ${s.en} <span class="badge">${s.name}</span></h3>` +
        `<p><span class="badge">${s.elEn}</span><span class="badge">ruler ${s.planet}</span></p>` +
        `<p>Approx window: ${s.start[0]}/${s.start[1]} – ${s.end[0]}/${s.end[1]}</p>` +
        `<p>Traits: ${s.traits}</p>`;
    });

    // Tool 2: Synastry
    const hpBtn = document.getElementById('hp-btn');
    const hpOut = document.getElementById('hp-result');
    hpBtn.addEventListener('click', () => {
      const a = readDate('hp-a'), b = readDate('hp-b');
      if (!a || !b) { hpOut.hidden = false; hpOut.textContent = 'Please pick both birth dates.'; return; }
      const sa = getSign(a.m, a.d), sb = getSign(b.m, b.d);
      const score = pairScore(sa.el, sb.el);
      hpOut.hidden = false;
      hpOut.innerHTML =
        `<div class="sc-card"><div class="score-ring">${score}</div><div>match score<br><span style="font-size:13px;color:var(--muted)">/ 100</span></div></div>` +
        `<p>${sa.sym} <b>${sa.en}</b> (${sa.elEn})　×　${sb.sym} <b>${sb.en}</b> (${sb.elEn})</p>` +
        `<p>${pairText(score)}</p>` +
        `<p style="font-size:13px;color:var(--muted)">Note: a simplified, element-based entertainment estimate — not pro astrology.</p>`;
    });

    // Tool 3: Birth Calendar (four pillars + solar term)
    const scBtn = document.getElementById('sc-btn');
    const scOut = document.getElementById('sc-result');
    scBtn.addEventListener('click', () => {
      const p = readDate('sc');
      if (!p) { scOut.hidden = false; scOut.textContent = 'Please pick a birth date.'; return; }
      const { h: hh, m: mm } = readTime('sc');
      const solar = Solar.fromYmdHms(p.y, p.m, p.d, hh, mm, 0);
      const lunar = Lunar.fromSolar(solar);
      const ec = lunar.getEightChar();
      const s = getSign(p.m, p.d);
      const animal = sx(p.y);
      const emoji = sxEmoji(p.y);
      const prevTerm = lunar.getPrevJieQi();
      const nextTerm = lunar.getNextJieQi();
      const termToday = lunar.getJieQi();
      const termText = termToday
        ? `Birth solar term: ${termToday}`
        : `Birth solar term: ${solar.subtract(prevTerm.getSolar())} days after ${prevTerm.getName()} · ${nextTerm.getSolar().subtract(solar)} days before ${nextTerm.getName()}`;
      scOut.hidden = false;
      scOut.innerHTML =
        `<div class="sc-card"><div class="sc-emoji">${emoji}</div><div class="sc-meta">` +
        `<p><b>${p.y}-${String(p.m).padStart(2,'0')}-${String(p.d).padStart(2,'0')} ${String(hh).padStart(2,'0')}:${String(mm).padStart(2,'0')}</b></p>` +
        `<p>${animal} year · Sun sign ${s.sym} ${s.en} (${s.elEn})</p>` +
        `<p style="color:var(--fg)">${SC_LINES[animal]}</p></div></div>` +
        `<table class="pillar-table"><thead><tr><th>Year</th><th>Month</th><th>Day</th><th>Hour</th></tr></thead>` +
        `<tbody><tr><td>${ec.getYear()}</td><td>${ec.getMonth()}</td><td>${ec.getDay()}</td><td>${ec.getTime()}</td></tr></tbody></table>` +
        `<p style="font-size:13px;color:var(--muted)">${termText}. Based on lunar-javascript solar-term and sexagenary-cycle algorithms. For entertainment only.</p>`;
    });

    setupDate('zx', 1990, 6, 15);
    setupDate('hp-a', 1990, 6, 15);
    setupDate('hp-b', 1992, 9, 20);
    setupDate('sc', 1990, 6, 15);
    setupTime('sc', 12, 0);
  </script>
</BlogPost>
